diff --git a/kernel/memlayout.h b/kernel/memlayout.h
--- a/kernel/memlayout.h
+++ b/kernel/memlayout.h
@@ -10,8 +10,13 @@
 
 #define DMWIN_MASK 0x9000000000000000
 
+#ifdef LS2K1000LA
+// LS2K1000LA firmware console, preserved at its configured baud rate.
+#define UART0 (0x1fe20000UL | DMWIN_MASK)
+#else
 // qemu puts UART registers here in virtual memory.
 #define UART0 (0x1fe001e0UL | DMWIN_MASK)
+#endif
 #define UART0_IRQ 2
 
 /* ============== LS7A registers =============== */
diff --git a/kernel/trap.c b/kernel/trap.c
--- a/kernel/trap.c
+++ b/kernel/trap.c
@@ -24,7 +24,11 @@ void
 trapinit(void)
 {
   initlock(&tickslock, "time");
+#ifdef LS2K1000LA
+  uint32 ecfg = ( 0U << CSR_ECFG_VS_SHIFT ) | TI_VEC;
+#else
   uint32 ecfg = ( 0U << CSR_ECFG_VS_SHIFT ) | HWI_VEC | TI_VEC;
+#endif
   uint64 tcfg = 0x1000000UL | CSR_TCFG_EN | CSR_TCFG_PER;
   w_csr_ecfg(ecfg);
   w_csr_tcfg(tcfg);
diff --git a/kernel/uart.c b/kernel/uart.c
--- a/kernel/uart.c
+++ b/kernel/uart.c
@@ -49,6 +49,11 @@ uartinit(void)
   // disable interrupts.
   WriteReg(IER, 0x00);
 
+#ifdef LS2K1000LA
+  // Preserve the divisor programmed by U-Boot for the board console.
+  WriteReg(FCR, FCR_FIFO_ENABLE | FCR_FIFO_CLEAR);
+  initlock(&uart_tx_lock, "uart");
+#else
   // special mode to set baud rate.
   WriteReg(LCR, LCR_BAUD_LATCH);
 
@@ -69,6 +74,7 @@ uartinit(void)
   WriteReg(IER, IER_TX_ENABLE | IER_RX_ENABLE);
 
   initlock(&uart_tx_lock, "uart");
+#endif
 }
 
