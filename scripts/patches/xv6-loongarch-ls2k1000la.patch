diff --git a/kernel/console.c b/kernel/console.c
--- a/kernel/console.c
+++ b/kernel/console.c
@@ -52,7 +52,11 @@ consolewrite(int user_src, uint64 src, int n)
     char c;
     if(either_copyin(&c, user_src, src+i, 1) == -1)
       break;
+#ifdef LS2K1000LA
+    uartputc_sync(c);
+#else
     uartputc(c);
+#endif
   }
 
   return i;
@@ -76,7 +80,15 @@ consoleread(int user_dst, uint64 dst, int n)
         release(&cons.lock);
         return -1;
       }
+#ifdef LS2K1000LA
+      release(&cons.lock);
+      c = uartgetc();
+      if(c >= 0)
+        consoleintr(c);
+      acquire(&cons.lock);
+#else
       sleep(&cons.r, &cons.lock);
+#endif
     }
 
     c = cons.buf[cons.r++ % INPUT_BUF];
diff --git a/kernel/entry.S b/kernel/entry.S
--- a/kernel/entry.S
+++ b/kernel/entry.S
@@ -12,13 +12,14 @@ _entry:
         # first jump loads from .data instead of the linked high-half target.
         # The linker script fixes _entry at 0x9000000000200000. Materialize
         # the 16-byte high-half target directly and keep this sequence fixed.
-        lu12i.w    $t0, 0x200
-        ori        $t0, $t0, 0x10
+        lu12i.w    $t0, -425984
+        ori        $t0, $t0, 0x14
+        lu32i.d    $t0, 0
         lu52i.d    $t0, $t0, -1792
         jirl        $zero, $t0, 0
 .global xv6_high_entry
 xv6_high_entry:
-.if (xv6_high_entry - _entry) != 0x10
+.if (xv6_high_entry - _entry) != 0x14
 .error "xv6 high-half entry offset changed"
 .endif
         li.d        $t0, 0x9000000000000011   # CA, PLV0, 0x9000 xxxx xxxx xxxx
