diff --git a/kernel/sbi.c b/kernel/sbi.c
index 75a5ccb..45ab436 100644
--- a/kernel/sbi.c
+++ b/kernel/sbi.c
@@ -41,7 +41,16 @@ void startothers(int boot_hartid) {
         exit(1);
     }
-    for (int i = 0; i < NCPU; i++) {
+#ifdef CONFIG_JH7110
+    // JH7110 exposes application harts 1 through 4. Hart 0 is the E24
+    // monitor core, while xv6's generic NCPU limit is larger than the SoC.
+    const int first_hart = 1;
+    const int hart_limit = 5;
+#else
+    const int first_hart = 0;
+    const int hart_limit = NCPU;
+#endif
+    for (int i = first_hart; i < hart_limit; i++) {
         if (i == boot_hartid)
             continue;
         sbi_hart_start(i, (uint64)KERNBASE, 1);
     }
