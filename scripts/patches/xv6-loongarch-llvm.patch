diff --git a/kernel/entry.S b/kernel/entry.S
index ebdb5a8..3db3967 100644
--- a/kernel/entry.S
+++ b/kernel/entry.S
@@ -8,9 +8,22 @@
 .section .text
 .global _entry
 _entry:
-        la.global   $t0, 0f
+        # LLVM's integrated assembler represents a numeric local label as
+        # `.text + addend` in R_LARCH_GOT_PC_* relocations. LLD 21 applies
+        # that addend both when selecting and addressing the GOT slot, so the
+        # first jump loads from .data instead of the linked high-half target.
+        # The linker script fixes _entry at 0x9000000000200000. Materialize
+        # the 16-byte high-half target directly and keep this sequence fixed.
+        lu12i.w    $t0, 0x200
+        ori        $t0, $t0, 0x10
+        lu52i.d    $t0, $t0, -1792
         jirl        $zero, $t0, 0
-0:      li.d        $t0, 0x9000000000000011   # CA, PLV0, 0x9000 xxxx xxxx xxxx
+.global xv6_high_entry
+xv6_high_entry:
+.if (xv6_high_entry - _entry) != 0x10
+.error "xv6 high-half entry offset changed"
+.endif
+        li.d        $t0, 0x9000000000000011   # CA, PLV0, 0x9000 xxxx xxxx xxxx
         csrwr       $t0, LOONGARCH_CSR_DMWIN0
         li.d        $t0, 0x0000000000000000   
         csrwr       $t0, LOONGARCH_CSR_DMWIN1
