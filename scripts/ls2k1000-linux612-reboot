#!/bin/sh
# Orderly exit from the Linux 6.12 competition environment.  In particular,
# do not jump from sync straight to SysRq: buildstorm leaves a large ext4
# orphan list unless every writer is stopped and sda2 is remounted read-only.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/glibc
export PATH

BB=/glibc/busybox
SWAP_MOUNT=/mnt/linux-root
SWAP_FILE="$SWAP_MOUNT/swapfile-moss"
PING_PID_FILE=/run/moss-wdt-pinger.pid
WDT_RELOAD=0x1fe27034

restart_pinger() {
    (
        while :; do
            "$BB" devmem "$WDT_RELOAD" 32 1 >/dev/null 2>&1 || exit 1
            "$BB" sleep 5
        done
    ) >/dev/null 2>&1 &
    echo $! >"$PING_PID_FILE"
}

echo "moss-reboot: draining swap while watchdog feeding remains active"
if "$BB" grep -qs "^$SWAP_FILE[[:space:]]" /proc/swaps; then
    "$BB" swapoff "$SWAP_FILE" || {
        echo "moss-reboot: swapoff failed; reboot cancelled" >&2
        exit 1
    }
fi

"$BB" sync
if "$BB" grep -qs " $SWAP_MOUNT " /proc/mounts; then
    "$BB" umount "$SWAP_MOUNT" || {
        echo "moss-reboot: cannot unmount $SWAP_MOUNT; reboot cancelled" >&2
        exit 1
    }
fi

pinger_pid=''
[ -r "$PING_PID_FILE" ] && pinger_pid=$("$BB" cat "$PING_PID_FILE")
if [ -n "$pinger_pid" ]; then
    "$BB" kill "$pinger_pid" 2>/dev/null || true
    wait "$pinger_pid" 2>/dev/null || true
fi
"$BB" rm -f "$PING_PID_FILE"

"$BB" sync
if ! "$BB" mount -o remount,ro /; then
    echo "moss-reboot: root read-only remount failed; reboot cancelled" >&2
    restart_pinger
    exit 1
fi
if ! "$BB" grep -qs ' / ext4 ro[, ]' /proc/mounts; then
    echo "moss-reboot: root still writable; reboot cancelled" >&2
    "$BB" mount -o remount,rw / 2>/dev/null || true
    restart_pinger
    exit 1
fi

echo "moss-reboot: root_ro=PASS; rebooting now"
"$BB" sync
echo b >/proc/sysrq-trigger

# SysRq reboot never returns.  If the kernel rejected it, keep the filesystem
# read-only and let the already-counting hardware watchdog finish the reset.
while :; do
    "$BB" sleep 60
done
