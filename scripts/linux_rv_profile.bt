profile:hz:19
{
    @cpu[comm, kstack] = count();
}

tracepoint:sched:sched_switch /args.prev_pid != 0 && args.prev_state != 0/
{
    @off_start[args.prev_pid] = nsecs;
    @off_stack[args.prev_pid] = kstack;
    @off_comm[args.prev_pid] = args.prev_comm;
    @off_state[args.prev_pid] = args.prev_state;
}

tracepoint:sched:sched_switch /@off_start[args.next_pid]/
{
    @offcpu[@off_comm[args.next_pid], @off_state[args.next_pid], @off_stack[args.next_pid]] =
        sum(nsecs - @off_start[args.next_pid]);
    delete(@off_start[args.next_pid]);
    delete(@off_stack[args.next_pid]);
    delete(@off_comm[args.next_pid]);
    delete(@off_state[args.next_pid]);
}

kprobe:__mutex_lock_slowpath
{
    @mutex_start[tid] = nsecs;
    @mutex_stack[tid] = kstack;
    @mutex_comm[tid] = comm;
}

kretprobe:__mutex_lock_slowpath /@mutex_start[tid]/
{
    @mutex[@mutex_comm[tid], @mutex_stack[tid]] = sum(nsecs - @mutex_start[tid]);
    delete(@mutex_start[tid]);
    delete(@mutex_stack[tid]);
    delete(@mutex_comm[tid]);
}

kprobe:rwsem_down_read_slowpath,
kprobe:rwsem_down_write_slowpath
{
    @rwsem_start[tid] = nsecs;
    @rwsem_stack[tid] = kstack;
    @rwsem_comm[tid] = comm;
}

kretprobe:rwsem_down_read_slowpath,
kretprobe:rwsem_down_write_slowpath /@rwsem_start[tid]/
{
    @rwsem[@rwsem_comm[tid], @rwsem_stack[tid]] = sum(nsecs - @rwsem_start[tid]);
    delete(@rwsem_start[tid]);
    delete(@rwsem_stack[tid]);
    delete(@rwsem_comm[tid]);
}

kprobe:filemap_fault,
kprobe:filemap_read
{
    @page_start[tid] = nsecs;
    @page_stack[tid] = kstack;
    @page_comm[tid] = comm;
}

kretprobe:filemap_fault,
kretprobe:filemap_read /@page_start[tid]/
{
    @pagecache[@page_comm[tid], @page_stack[tid]] = sum(nsecs - @page_start[tid]);
    delete(@page_start[tid]);
    delete(@page_stack[tid]);
    delete(@page_comm[tid]);
}

kprobe:ext4_file_read_iter,
kprobe:ext4_buffered_write_iter
{
    @ext4_start[tid] = nsecs;
    @ext4_stack[tid] = kstack;
    @ext4_comm[tid] = comm;
}

kretprobe:ext4_file_read_iter,
kretprobe:ext4_buffered_write_iter /@ext4_start[tid]/
{
    @ext4[@ext4_comm[tid], @ext4_stack[tid]] = sum(nsecs - @ext4_start[tid]);
    delete(@ext4_start[tid]);
    delete(@ext4_stack[tid]);
    delete(@ext4_comm[tid]);
}

kprobe:submit_bio_noacct
{
    $bio = (struct bio *)arg0;
    @bio_start[$bio] = nsecs;
    @bio_stack[$bio] = kstack;
    @bio_comm[$bio] = comm;
    @bio_op[$bio] = $bio->bi_opf & 0xff;
}

kprobe:bio_endio /@bio_start[(struct bio *)arg0]/
{
    $bio = (struct bio *)arg0;
    if (@bio_op[$bio] == 0) {
        @block_read[@bio_comm[$bio], @bio_stack[$bio]] = sum(nsecs - @bio_start[$bio]);
    } else if (@bio_op[$bio] == 1) {
        @block_write[@bio_comm[$bio], @bio_stack[$bio]] = sum(nsecs - @bio_start[$bio]);
    }
    delete(@bio_start[$bio]);
    delete(@bio_stack[$bio]);
    delete(@bio_comm[$bio]);
    delete(@bio_op[$bio]);
}

END
{
    clear(@off_start);
    clear(@off_stack);
    clear(@off_comm);
    clear(@off_state);
    clear(@mutex_start);
    clear(@mutex_stack);
    clear(@mutex_comm);
    clear(@rwsem_start);
    clear(@rwsem_stack);
    clear(@rwsem_comm);
    clear(@page_start);
    clear(@page_stack);
    clear(@page_comm);
    clear(@ext4_start);
    clear(@ext4_stack);
    clear(@ext4_comm);
    clear(@bio_start);
    clear(@bio_stack);
    clear(@bio_comm);
    clear(@bio_op);
}
