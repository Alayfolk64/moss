#!/bin/sh
# Minimal PID 1 for the LS2K1000LA competition root under Linux 6.12.
# The BSP2 disk wrapper enters Linux with a 30-second hardware watchdog.
# Keep feeding it only after the writable root and the persistent swap file
# are ready, so failures anywhere in the boot handoff return to factory U-Boot.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/glibc
HOME=/root
USER=root
LOGNAME=root
RUSTUP_HOME=/root/.rustup
CARGO_HOME=/root/.cargo
RUSTUP_TOOLCHAIN=nightly-2026-05-28
CARGO_NET_OFFLINE=true
export PATH HOME USER LOGNAME RUSTUP_HOME CARGO_HOME RUSTUP_TOOLCHAIN CARGO_NET_OFFLINE
PATH="$CARGO_HOME/bin:$PATH"
export PATH

BB=/glibc/busybox
WDT_RELOAD=0x1fe27034
SWAP_MOUNT=/mnt/linux-root
SWAP_FILE="$SWAP_MOUNT/swapfile-moss"
PING_PID_FILE=/run/moss-wdt-pinger.pid

fail_boot() {
    echo "moss-linux612-init: FATAL: $*" >&2
    echo "moss-linux612-init: stop here; the 30-second hardware watchdog will reset the board" >&2
    while :; do
        "$BB" sleep 60
    done
}

[ -x "$BB" ] || fail_boot "missing $BB"

"$BB" grep -qs ' /proc proc ' /proc/mounts 2>/dev/null || "$BB" mount -t proc proc /proc
"$BB" grep -qs ' /sys sysfs ' /proc/mounts || "$BB" mount -t sysfs sysfs /sys
"$BB" grep -qs ' /dev/pts devpts ' /proc/mounts || "$BB" mount -t devpts devpts /dev/pts
"$BB" grep -qs ' /run tmpfs ' /proc/mounts || "$BB" mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run

"$BB" mount -o remount,rw / || fail_boot "cannot remount /dev/sda2 read-write"
"$BB" grep -qs ' / ext4 rw[, ]' /proc/mounts || fail_boot "/dev/sda2 is not read-write"
"$BB" mkdir -p "$SWAP_MOUNT" || fail_boot "cannot create $SWAP_MOUNT"
"$BB" ip link set lo up || fail_boot "cannot enable loopback"

if ! "$BB" grep -qs " $SWAP_MOUNT " /proc/mounts; then
    "$BB" mount -t ext4 -o rw /dev/sda1 "$SWAP_MOUNT" || fail_boot "cannot mount /dev/sda1"
fi

if ! "$BB" grep -qs "^$SWAP_FILE[[:space:]]" /proc/swaps; then
    "$BB" swapon "$SWAP_FILE" || fail_boot "cannot activate $SWAP_FILE"
fi
"$BB" grep -qs "^$SWAP_FILE[[:space:]]" /proc/swaps || fail_boot "swap did not become active"

# The watchdog counter and reset enable were programmed by BSP2 immediately
# before bootm.  A direct reload is used because this vendor DT exposes the
# working LS2K register block but not a dependable /dev/watchdog node.
"$BB" devmem "$WDT_RELOAD" 32 1 >/dev/null || fail_boot "initial watchdog reload failed"
(
    while :; do
        "$BB" devmem "$WDT_RELOAD" 32 1 >/dev/null 2>&1 || exit 1
        "$BB" sleep 5
    done
) >/dev/null 2>&1 &
echo $! >"$PING_PID_FILE"

echo "moss-linux612-init: READY"
echo "kernel=$(uname -r) root=/dev/sda2 swap=$SWAP_FILE watchdog=30s/ping-5s"
"$BB" free -m
"$BB" cat /proc/swaps
echo "Use /sbin/moss-reboot for a filesystem-safe reboot."

exec /bin/bash --login
